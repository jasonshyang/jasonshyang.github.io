---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-copy">
      <span>© {year} {site.name}</span>
      <span class="footer-tag">Rust · systems · financial mechanics</span>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href={site.github} rel="noopener noreferrer" target="_blank">GitHub</a>
      <a href={site.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
      <a href={site.repo} rel="noopener noreferrer" target="_blank">Source</a>
    </nav>
  </div>
</footer>
